# Nature journal style matplotlib configuration
# Based on: https://research-figure-guide.nature.com/figures/preparing-figures-our-specifications/
# and https://research-figure-guide.nature.com/figures/building-and-exporting-figure-panels/

# Figure size (single column width is 89mm, ~3.5 inches)
figure.figsize: 3.5, 2.625  # Single column width, with 3:4 aspect ratio
figure.dpi: 500  # High resolution for publication

# Font sizes (Nature recommends 5-7 pt)
font.size: 7
axes.labelsize: 7
axes.titlesize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
figure.titlesize: 7

# Font family
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans, sans-serif

# Line widths (Nature recommends 0.25-1 pt)
axes.linewidth: 0.5
lines.linewidth: 1.0
lines.markersize: 3
patch.linewidth: 0.5

# Grid
axes.grid: False
grid.linewidth: 0.5
grid.alpha: 0.5

# Ticks
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.minor.width: 0.25
ytick.minor.width: 0.25
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.minor.size: 1.5
ytick.minor.size: 1.5
xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True

# Legend
legend.frameon: False
legend.numpoints: 1
legend.scatterpoints: 1

# Colors - using a professional palette
axes.prop_cycle: cycler('color', ['0C5DA5', 'FF2C00', '00B945', 'FF9500', '845B97', '474747', '9e9e9e'])

# Saving figures
savefig.dpi: 300
savefig.format: pdf
savefig.bbox: tight
savefig.pad_inches: 0.05

# Other
axes.spines.top: True
axes.spines.right: True
axes.axisbelow: True